{\rtf1\ansi\ansicpg1250\uc1\deff0{\fonttbl{\f0\froman Times New Roman;}{\f1\fmodern Courier New;}{\f2\fswiss Arial;}}{\colortbl;\red0\green0\blue0;\red100\green100\blue100;}\paperw11906\paperh16838\margl1418\margr1418\margt1418\margb1418\fs22\f0\lang1029\pard\sb0\sa280\qc\f0\b\fs32 Rovnice k dopln\u283?n\u237? do kapitoly 5\b0\fs22\par
\pard\sa120\sl300\slmult1\ql Tento soubor obsahuje t\u345?i kr\u225?tk\u233? bloky, kter\u233? sta\u269?\u237? zkop\u237?rovat do st\u225?vaj\u237?c\u237?ho Word dokumentu (kapitola 5) na uveden\u225? m\u237?sta. Styl form\u225?ln\u237?ho z\u225?pisu model\u367? odpov\u237?d\u225? doporu\u269?en\u237? vedouc\u237?ho (pojmenovan\u233? vektory regresor\u367?, analogicky Mincerovu p\u345?\u237?kladu s vektory PT, PE, FB, JE, LO). Pro multinomick\u253? logit je dle vedouc\u237?ho uvedena pouze kr\u225?tk\u225? zm\u237?nka bez samostatn\u233? form\u225?ln\u237? rovnice.\par
\pard\sb280\sa140\keepn\f0\b\fs28 \u167?5.2 \u8212? bin\u225?rn\u237? logit\b0\fs22\par
\pard\sb240\sa80\keepn\f0\i\cf2 Vlo\u382?it za paragraf kon\u269?\u237?c\u237? slovy \u8222?\u8230? pro USA, N\u283?mecko a Indii.\u8220? (hned za prvn\u237? odstavec sekce \u8222?5.2 Determinanty AI po\u382?adavku (bin\u225?rn\u237? logit)\u8220?).\i0\cf1\par
\pard\sa120\sl300\slmult1\ql Pro modelov\u225?n\u237? pravd\u283?podobnosti AI po\u382?adavku odhadujeme bin\u225?rn\u237? logistick\u253? model\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 has_ai}{\sub i} = 1 | {\i JF}{\sub i}, {\i HC}{\sub i}, {\i FC}{\sub i}, {\i SE}{\sub i}, {\i WA}{\sub i}) = {\i F}\u8201?({\i \u945?} + {\i \u946?}\u183?{\i JF}{\sub i} + {\i \u947?}\u183?{\i HC}{\sub i} + {\i \u948?}\u183?{\i FC}{\sub i} + {\i \u950?}\u183?{\i SE}{\sub i} + {\i \u951?}\u183?{\i WA}{\sub i})\par
\pard\sa120\sl300\slmult1\ql objas\u328?uj\u237?c\u237? pravd\u283?podobnost AI po\u382?adavku v pracovn\u237?m inzer\u225?tu, p\u345?i\u269?em\u382? z\u225?visl\u225? prom\u283?nn\u225? {\f1 has_ai}{\sub i} nab\u253?v\u225? hodnoty 1 u inzer\u225?t\u367? klasifikovan\u253?ch jako AI Integration nebo Applied/Core AI a hodnoty 0 u inzer\u225?t\u367? bez AI po\u382?adavku. Tento v\u253?sledek je predikov\u225?n vektorem vysv\u283?tluj\u237?c\u237?ch prom\u283?nn\u253?ch pro ka\u382?d\u253? inzer\u225?t ({\i i}), rozlo\u382?en\u253?m do tematick\u253?ch skupin: vektoru profesn\u237? skupiny {\i JF}{\sub i} ({\f1 job_family} podle Tabulky 2); vektoru lidsk\u233?ho kapit\u225?lu {\i HC}{\sub i} (vzd\u283?l\u225?n\u237? {\f1 edu_logit} s referen\u269?n\u237? kategori\u237? Bachelor+ a kategorie zku\u353?enost\u237? {\f1 exp_category} s referen\u269?n\u237? kategori\u237? Mid 3\u8211?5 let); vektoru firemn\u237?ch charakteristik {\i FC}{\sub i} (typ organizace a velikost firmy); vektoru sektorov\u253?ch indik\u225?tor\u367? {\i SE}{\sub i} (NACE Rev. 2 na \u250?rovni 1-digit); a indik\u225?toru pracovn\u237?ho uspo\u345?\u225?d\u225?n\u237? {\i WA}{\sub i} (dummy remote pr\u225?ce). V alternativn\u237? specifikaci (Tabulka 3) je vektor {\i JF}{\sub i} nahrazen vektorem {\i SC}{\sub i} obsahuj\u237?c\u237?m 21 bin\u225?rn\u237?ch indik\u225?tor\u367? skill cluster\u367?. {\i F} zna\u269?\u237? kumulativn\u237? standardn\u237? logistickou distribu\u269?n\u237? funkci a {\i \u946?}, {\i \u947?}, {\i \u948?}, {\i \u950?}, {\i \u951?} jsou vektory odhadovan\u253?ch parametr\u367?. Parametry jsou odhadov\u225?ny metodou maxim\u225?ln\u237? v\u283?rohodnosti se standardn\u237?mi chybami klastrovan\u253?mi na \u250?rovni firmy.\par
\pard\sb280\sa140\keepn\f0\b\fs28 \u167?5.3 \u8212? multinomick\u253? logit (kr\u225?tk\u225? zm\u237?nka)\b0\fs22\par
\pard\sb240\sa80\keepn\f0\i\cf2 Vlo\u382?it za paragraf kon\u269?\u237?c\u237? slovy \u8222?\u8230? velikost firmy, remote pr\u225?ce).\u8220? (za druh\u253? odstavec sekce \u8222?5.3 Pou\u382?\u237?v\u225?n\u237? vs. v\u253?voj AI\u8220?).\i0\cf1\par
\pard\sa120\sl300\slmult1\ql Multinomick\u253? logit roz\u353?i\u345?uje bin\u225?rn\u237? logit z \u167?5.2 na t\u345?\u237?hodnotovou z\u225?vislou prom\u283?nnou {\f1 ai_level}{\sub i} \u8712? \{None, AI Integration, Applied/Core AI\} (kategorie None slou\u382?\u237? jako referen\u269?n\u237?) a v t\u233?to pr\u225?ci je vyu\u382?it jako up\u345?esn\u283?n\u237? v\u253?sledk\u367? bin\u225?rn\u237?ho logitu. Form\u225?ln\u237? z\u225?pis modelu je struktur\u225?ln\u283? analogick\u253? rovnici bin\u225?rn\u237?ho logitu z \u167?5.2 \u8212? pro ka\u382?dou z nereferen\u269?n\u237?ch kategori\u237? se modeluje logaritmick\u225? \u353?ance proti kategorii None jako line\u225?rn\u237? kombinace t\u233?\u382?e sady regresor\u367? (viz specifikaci v p\u345?edchoz\u237?m odstavci) \u8212? a nen\u237? zde proto samostatn\u283? uv\u225?d\u283?n. Analytick\u253? p\u345?\u237?nos t\u233?to specifikace oproti bin\u225?rn\u237?mu logitu spo\u269?\u237?v\u225? v tom, \u382?e dovednostn\u237? determinanty povrchov\u233? integrace AI (AI Integration) a hlubok\u233? AI expert\u237?zy (Applied/Core AI) lze zachytit odd\u283?len\u283?, nikoli jako jejich slou\u269?en\u253? efekt.\par
\pard\sb280\sa140\keepn\f0\b\fs28 \u167?5.4 \u8212? OLS mzdov\u225? regrese (Mincer)\b0\fs22\par
\pard\sb240\sa80\keepn\f0\i\cf2 Vlo\u382?it za paragraf kon\u269?\u237?c\u237? slovy \u8222?\u8230? ov\u283?\u345?ena v P\u345?\u237?loze D.\u8220? (za prvn\u237? odstavec sekce \u8222?5.4 Mzdov\u225? pr\u233?mie za AI (OLS)\u8220?).\i0\cf1\par
\pard\sa120\sl300\slmult1\ql Pro odhad mzdov\u253?ch efekt\u367? AI dovednost\u237? je pou\u382?ita mzdov\u225? rovnice Mincerova typu (Lemieux, 2006; Mincer, 1974), kde ln\u8201?{\i w}{\sub i} ozna\u269?uje p\u345?irozen\u253? logaritmus inzerovan\u233? ro\u269?n\u237? mzdy u {\i i}-t\u233?ho inzer\u225?tu (v USD; konverze m\u283?n u n\u283?meck\u253?ch a indick\u253?ch inzer\u225?t\u367? je pops\u225?na v \u167?5.1). Vysv\u283?tluj\u237?c\u237? prom\u283?nn\u233? zahrnuj\u237? vektor \u250?rovn\u237? AI {\i AI}{\sub i} (bin\u225?rn\u237? indik\u225?tory pro {\f1 ai_level} = AI Integration a {\f1 ai_level} = Applied/Core AI, s referen\u269?n\u237? kategori\u237? None); vektor lidsk\u233?ho kapit\u225?lu {\i HC}{\sub i} (kategorick\u233? vzd\u283?l\u225?n\u237? {\f1 edu_ols} s 5 \u250?rovn\u283?mi a kategorie zku\u353?enost\u237? {\f1 exp_category} se 4 \u250?rovn\u283?mi); vektor dovednostn\u237?ch klastr\u367? {\i SC}{\sub i} (19 bin\u225?rn\u237?ch indik\u225?tor\u367? skill cluster\u367?, tj. v\u353?ech 21 technick\u253?ch rodin dovednost\u237? krom\u283? Generative AI a Data Science\u8201?/\u8201?ML, kter\u233? jsou vy\u345?azeny kv\u367?li cirkularit\u283? s klasifikac\u237? {\f1 ai_level}); vektor firemn\u237?ch charakteristik {\i FC}{\sub i} (typ organizace a velikost firmy); vektor sektorov\u253?ch indik\u225?tor\u367? {\i SE}{\sub i} (NACE Rev. 2 na \u250?rovni 1-digit); a indik\u225?tor pracovn\u237?ho uspo\u345?\u225?d\u225?n\u237? {\i WA}{\sub i} (dummy remote pr\u225?ce). Odhadovan\u253? model m\u225? tvar:\par
\pard\sb120\sa160\sl280\slmult1\qc ln\u8201?{\i w}{\sub i} = {\i \u945?} + {\i \u947?}\u183?{\i AI}{\sub i} + {\i \u946?}{\sub 1}\u183?{\i HC}{\sub i} + {\i \u946?}{\sub 2}\u183?{\i SC}{\sub i} + {\i \u946?}{\sub 3}\u183?{\i FC}{\sub i} + {\i \u946?}{\sub 4}\u183?{\i SE}{\sub i} + {\i \u946?}{\sub 5}\u183?{\i WA}{\sub i} + {\i \u949?}{\sub i}\par
\pard\sa120\sl300\slmult1\ql kde {\i \u947?} a {\i \u946?}{\sub 1} a\u382? {\i \u946?}{\sub 5} jsou vektory regresn\u237?ch koeficient\u367? p\u345?i\u345?azen\u233? p\u345?\u237?slu\u353?n\u253?m skupin\u225?m regresor\u367? a {\i \u949?}{\sub i} je n\u225?hodn\u225? chyba. Hlavn\u237?m z\u225?jmov\u253?m vektorem je {\i \u947?} = ({\i \u947?}{\sub 1}, {\i \u947?}{\sub 2})\u8242?; jeho slo\u382?ky {\i \u947?}{\sub k} ({\i k}\u8201?=\u8201?1, 2) odpov\u237?daj\u237? p\u345?i log-line\u225?rn\u237? specifikaci p\u345?ibli\u382?n\u283? semielasticit\u225?m mzdy v\u367?\u269?i p\u345?\u237?slu\u353?n\u233? \u250?rovni AI, p\u345?i\u269?em\u382? relativn\u237? mzdov\u225? pr\u233?mie je p\u345?esn\u283? rovna 100\u183?[exp({\i \u947?}{\sub k})\u8201?\u8722?\u8201?1]\u8201?% (p\u345?i mal\u253?ch hodnot\u225?ch {\i \u947?}{\sub k} p\u345?ibli\u382?n\u283? 100\u183?{\i \u947?}{\sub k}\u8201?%). Model je odhadnut samostatn\u283? pro ka\u382?dou zemi (USA, N\u283?mecko, Indie) se standardn\u237?mi chybami klastrovan\u253?mi na \u250?rovni firmy.\par
