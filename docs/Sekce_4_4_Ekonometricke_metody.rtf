{\rtf1\ansi\ansicpg1250\uc1\deff0{\fonttbl{\f0\froman Times New Roman;}{\f1\fmodern Courier New;}{\f2\fswiss Arial;}}{\colortbl;\red0\green0\blue0;\red80\green80\blue80;}\paperw11906\paperh16838\margl1418\margr1418\margt1418\margb1418\fs22\f0\lang1029\pard\sb360\sa160\keepn\f0\b\fs36 4.4 Ekonometrick\u233? metody\b0\fs22\par
\pard\sa120\sl300\slmult1\ql Samotn\u225? anal\u253?za stoj\u237? na t\u345?ech hlavn\u237?ch typech model\u367?. Bin\u225?rn\u237? logistick\u225? regrese modeluje pravd\u283?podobnost, zda inzer\u225?t vy\u382?aduje AI dovednosti, a jej\u237?m c\u237?lem je zjistit, jak\u253? typ pozice a technologick\u253? profil se s AI po\u382?adavky poj\u237?. V\u253?sledky jsou reportov\u225?ny jako pr\u367?m\u283?rn\u233? margin\u225?ln\u237? efekty (AME), tedy hodnoty, kter\u233? lze rovnou \u269?\u237?st jako zm\u283?nu pravd\u283?podobnosti v procentn\u237?ch bodech p\u345?i zm\u283?n\u283? nez\u225?visl\u233? prom\u283?nn\u233? o jednotku. Multinomick\u225? logistick\u225? regrese rozli\u353?uje dva typy AI pozic, AI Integration a Applied/Core AI, proti referen\u269?n\u237? kategorii None, a umo\u382?\u328?uje tak zachytit, v \u269?em se li\u353?\u237? pozice, kter\u233? AI pouze pou\u382?\u237?vaj\u237?, od t\u283?ch, kde se AI re\u225?ln\u283? vyv\u237?j\u237?. OLS mzdov\u225? regrese kvantifikuje mzdovou pr\u233?mii za AI dovednosti. Z\u225?vislou prom\u283?nnou je {\f1 ln_salary}; specifikace vych\u225?z\u237? z Mincerovy mzdov\u233? rovnice (Mincer, 1974) roz\u353?\u237?\u345?en\u233? o \u250?rovn\u283? AI a kontrolu dovednost\u237?, pozice a firmy. Hlavn\u237? specifikace je odhadov\u225?na zvl\u225?\u353?\u357? pro ka\u382?dou zemi.\par
\pard\sa120\sl300\slmult1\ql V n\u225?sleduj\u237?c\u237?ch pododd\u237?lech je uveden form\u225?ln\u237? z\u225?pis ka\u382?d\u233?ho modelu. Ve v\u353?ech p\u345?\u237?padech ozna\u269?uje {\i i} po\u345?adov\u233? \u269?\u237?slo inzer\u225?tu ({\i i} = 1, \u8230?, {\i N}), {\i x}{\sub i} vektor nez\u225?visl\u253?ch prom\u283?nn\u253?ch a {\i \u946?} (p\u345?\u237?padn\u283? {\i \u947?}, {\i \u945?}) vektory odhadovan\u253?ch parametr\u367?.\par
\pard\sb280\sa140\keepn\f0\b\fs28 4.4.1 Bin\u225?rn\u237? logistick\u225? regrese\b0\fs22\par
\pard\sa120\sl300\slmult1\ql Z\u225?vislou prom\u283?nnou je bin\u225?rn\u237? indik\u225?tor {\f1 has_ai}{\sub i} \u8712? \{0, 1\}, kter\u253? nab\u253?v\u225? hodnoty 1 pro inzer\u225?ty klasifikovan\u233? jako AI Integration nebo Applied/Core AI a hodnoty 0 pro inzer\u225?ty bez AI po\u382?adavku. Pravd\u283?podobnost AI po\u382?adavku podm\u237?n\u283?n\u225? vektorem nez\u225?visl\u253?ch prom\u283?nn\u253?ch {\i x}{\sub i} je modelov\u225?na logistickou distribu\u269?n\u237? funkc\u237? \u923?(\u183?):\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 has_ai}{\sub i} = 1 | {\i x}{\sub i}) = \u923?({\i x}{\sub i}\u8242? {\i \u946?}) = exp({\i x}{\sub i}\u8242? {\i \u946?})\u8201?/\u8201?[1 + exp({\i x}{\sub i}\u8242? {\i \u946?})]\par
\pard\sb0\sa160\qr\i (4.1)\i0\par
\pard\sa120\sl300\slmult1\ql ekvivalentn\u237? z\u225?pis prost\u345?ednictv\u237?m logitov\u233? transformace:\par
\pard\sb120\sa160\sl280\slmult1\qc logit\u8201?{\i P}{\sub i} = ln \{{\i P}{\sub i} / (1 \u8722? {\i P}{\sub i})\} = {\i \u946?}{\sub 0} + {\i \u946?}{\sub 1}{\i x}{\sub 1{\i i}} + \u8230? + {\i \u946?}{\sub K}{\i x}{\sub K{\i i}}\par
\pard\sb0\sa160\qr\i (4.2)\i0\par
\pard\sa120\sl300\slmult1\ql Vektor {\i x}{\sub i} obsahuje profesn\u237? skupinu ({\f1 job_family}, Tabulka 2), vzd\u283?l\u225?n\u237? ({\f1 edu_logit}, 3 \u250?rovn\u283? s referen\u269?n\u237? kategori\u237? Bachelor+), zku\u353?enosti ({\f1 exp_category}, 4 \u250?rovn\u283? s referen\u269?n\u237? kategori\u237? Mid 3\u8211?5 let), NACE sektor, typ a velikost firmy a indik\u225?tor remote pr\u225?ce. V alternativn\u237? specifikaci (Tabulka 3) je {\f1 job_family} nahrazena 21 bin\u225?rn\u237?mi indik\u225?tory skill cluster\u367? p\u345?i zachov\u225?n\u237? ostatn\u237?ch kontrol.\par
\pard\sa120\sl300\slmult1\ql Pro p\u345?ehlednost lze regresory rozd\u283?lit do tematick\u253?ch vektor\u367?: profesn\u237? skupina {\i JF}{\sub i} ({\f1 job_family}), lidsk\u253? kapit\u225?l {\i HC}{\sub i} (vzd\u283?l\u225?n\u237? a zku\u353?enost), firemn\u237? charakteristiky {\i FC}{\sub i} (typ a velikost firmy), sektor {\i SE}{\sub i} (NACE 1-digit) a pracovn\u237? uspo\u345?\u225?d\u225?n\u237? {\i WA}{\sub i} (remote). Bin\u225?rn\u237? logit (4.1) lze pak ekvivalentn\u283? zapsat ve tvaru:\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 has_ai}{\sub i} = 1 | {\i JF}{\sub i}, {\i HC}{\sub i}, {\i FC}{\sub i}, {\i SE}{\sub i}, {\i WA}{\sub i}) = {\i F}\u8201?({\i \u945?} + {\i \u946?}\u183?{\i JF}{\sub i} + {\i \u947?}\u183?{\i HC}{\sub i} + {\i \u948?}\u183?{\i FC}{\sub i} + {\i \u950?}\u183?{\i SE}{\sub i} + {\i \u951?}\u183?{\i WA}{\sub i})\par
\pard\sb0\sa160\qr\i (4.1\u8242?)\i0\par
\pard\sa120\sl300\slmult1\ql kde {\i F}\u8201?(\u183?) = \u923?(\u183?) je kumulativn\u237? standardn\u237? logistick\u225? distribu\u269?n\u237? funkce a {\i \u945?}, {\i \u946?}, {\i \u947?}, {\i \u948?}, {\i \u950?}, {\i \u951?} jsou konstanta a vektory odhadovan\u253?ch parametr\u367?. Parametry jsou odhadov\u225?ny metodou maxim\u225?ln\u237? v\u283?rohodnosti (MLE). Pro p\u345?\u237?mou interpretaci jsou reportov\u225?ny pr\u367?m\u283?rn\u233? margin\u225?ln\u237? efekty:\par
\pard\sb120\sa160\sl280\slmult1\qc AME{\sub k} = (1\u8201?/\u8201?{\i N})\u8201?\u931?{\sub i=1}{\super N}\u8201?\u8706?{\i P}\u8201?({\f1 has_ai}{\sub i} = 1 | {\i x}{\sub i}) / \u8706?{\i x}{\sub k{\i i}}\par
\pard\sb0\sa160\qr\i (4.3)\i0\par
\pard\sa120\sl300\slmult1\ql Koeficient AME{\sub k} ud\u225?v\u225? pr\u367?m\u283?rnou zm\u283?nu pravd\u283?podobnosti AI po\u382?adavku (v procentn\u237?ch bodech) odpov\u237?daj\u237?c\u237? zm\u283?n\u283? prom\u283?nn\u233? {\i x}{\sub k} o jednotku, resp. p\u345?echodu z referen\u269?n\u237? kategorie u kategori\u225?ln\u237?ch prom\u283?nn\u253?ch.\par
\pard\sb280\sa140\keepn\f0\b\fs28 4.4.2 Multinomick\u225? logistick\u225? regrese\b0\fs22\par
\pard\sa120\sl300\slmult1\ql Multinomick\u253? logit roz\u353?i\u345?uje bin\u225?rn\u237? model na t\u345?\u237?hodnotovou z\u225?vislou prom\u283?nnou {\f1 ai_level}{\sub i} \u8712? \{0, 1, 2\}, kde 0 = None, 1 = AI Integration a 2 = Applied/Core AI. Referen\u269?n\u237? kategori\u237? je {\i j} = 0 (None), pro kterou plat\u237? identifika\u269?n\u237? omezen\u237? {\i \u946?}{\sub 0} = 0. Pravd\u283?podobnosti jednotliv\u253?ch \u250?rovn\u237? jsou:\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 ai_level}{\sub i} = {\i j} | {\i x}{\sub i}) = exp({\i x}{\sub i}\u8242? {\i \u946?}{\sub j})\u8201?/\u8201?[1 + \u931?{\sub m=1}{\super 2} exp({\i x}{\sub i}\u8242? {\i \u946?}{\sub m})],\u8195? {\i j} \u8712? \{1, 2\}\par
\pard\sb0\sa160\qr\i (4.4)\i0\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 ai_level}{\sub i} = 0 | {\i x}{\sub i}) = 1\u8201?/\u8201?[1 + \u931?{\sub m=1}{\super 2} exp({\i x}{\sub i}\u8242? {\i \u946?}{\sub m})]\par
\pard\sb0\sa160\qr\i (4.5)\i0\par
\pard\sa120\sl300\slmult1\ql Analogicky k z\u225?pisu (4.1\u8242?) lze multinomick\u253? logit pro {\i j} \u8712? \{1, 2\} p\u345?epsat v explicitn\u283? vektorov\u233? form\u283?, kde {\i SC}{\sub i} ozna\u269?uje vektor 21 skill cluster\u367? a ostatn\u237? vektory ({\i HC}{\sub i}, {\i FC}{\sub i}, {\i SE}{\sub i}, {\i WA}{\sub i}) jsou definov\u225?ny jako v (4.1\u8242?):\par
\pard\sb120\sa160\sl280\slmult1\qc {\i P}\u8201?({\f1 ai_level}{\sub i} = {\i j} | {\i SC}{\sub i}, {\i HC}{\sub i}, {\i FC}{\sub i}, {\i SE}{\sub i}, {\i WA}{\sub i}) = \u923?{\sub j}\u8201?({\i \u945?}{\sub j} + {\i \u946?}{\sub j}\u183?{\i SC}{\sub i} + {\i \u947?}{\sub j}\u183?{\i HC}{\sub i} + {\i \u948?}{\sub j}\u183?{\i FC}{\sub i} + {\i \u950?}{\sub j}\u183?{\i SE}{\sub i} + {\i \u951?}{\sub j}\u183?{\i WA}{\sub i})\par
\pard\sb0\sa160\qr\i (4.4\u8242?)\i0\par
\pard\sa120\sl300\slmult1\ql kde \u923?{\sub j}\u8201?(\u183?) je multinomick\u225? logistick\u225? funkce pro kategorii {\i j} (srov. 4.4) a {\i \u945?}{\sub j}, {\i \u946?}{\sub j}, {\i \u947?}{\sub j}, {\i \u948?}{\sub j}, {\i \u950?}{\sub j}, {\i \u951?}{\sub j} jsou kategorie-specifick\u233? vektory koeficient\u367?.\par
\pard\sa120\sl300\slmult1\ql Ka\u382?d\u225? z kategori\u237? {\i j} \u8712? \{1, 2\} m\u225? vlastn\u237? vektor koeficient\u367? {\i \u946?}{\sub j}, model tedy umo\u382?\u328?uje odd\u283?lit determinanty povrchov\u233? integrace AI ({\i \u946?}{\sub 1}) od determinant\u367? hlubok\u233? AI expert\u237?zy ({\i \u946?}{\sub 2}). Vektor {\i x}{\sub i} obsahuje v\u353?ech 21 skill cluster\u367? (v\u269?etn\u283? Generative AI a Data Science\u8201?/\u8201?ML, jeliko\u382? c\u237?lem je pr\u225?v\u283? popsat, jak\u253?m profil\u367?m dovednost\u237? LLM jednotliv\u233? AI \u250?rovn\u283? p\u345?isuzuje), zku\u353?enosti ({\f1 exp_category}), NACE sektor, typ a velikost firmy a indik\u225?tor remote pr\u225?ce. Vzd\u283?l\u225?n\u237? ({\f1 edu_logit}) je z multinomick\u233?ho logitu z\u225?m\u283?rn\u283? vy\u345?azeno, proto\u382?e kombinace kategorie High School\u8201?/\u8201?Associate s \u250?rovn\u237? Applied/Core AI m\u225? v n\u283?meck\u233?m a indick\u233?m vzorku m\u233?n\u283? ne\u382? 25 pozorov\u225?n\u237? a model by byl ohro\u382?en quasi-complete separation. Stejn\u283? jako u bin\u225?rn\u237?ho logitu jsou v\u253?sledky interpretov\u225?ny prost\u345?ednictv\u237?m AME zvl\u225?\u353?\u357? pro ka\u382?dou \u250?rove\u328? {\i j} (pomoc\u237? {\i margins} {\i dydx}(*) {\i predict}(outcome({\i j}))). P\u345?edpoklad nez\u225?vislosti irelevantn\u237?ch alternativ (IIA) je ov\u283?\u345?en Hausmanov\u253?m testem (viz P\u345?\u237?loha).\par
\pard\sb280\sa140\keepn\f0\b\fs28 4.4.3 OLS mzdov\u225? regrese (Mincerova specifikace)\b0\fs22\par
\pard\sa120\sl300\slmult1\ql OLS regrese kvantifikuje \u269?istou mzdovou pr\u233?mii za AI dovednosti po kontrole pozorovateln\u253?ch faktor\u367?. Vych\u225?z\u237? z Mincerovy mzdov\u233? rovnice (Mincer, 1974), roz\u353?\u237?\u345?en\u233? o \u250?rovn\u283? AI a bohatou sadu kontrol na \u250?rovni inzer\u225?tu a firmy:\par
\pard\sb120\sa160\sl280\slmult1\qc ln({\i w}{\sub i}) = {\i \u945?} + {\i \u947?}{\sub 1}\u183?AI_Integration{\sub i} + {\i \u947?}{\sub 2}\u183?Applied_Core_AI{\sub i} + {\i x}{\sub i}\u8242? {\i \u946?} + {\i \u949?}{\sub i}\par
\pard\sb0\sa160\qr\i (4.6)\i0\par
\pard\sa120\sl300\slmult1\ql kde jednotliv\u233? symboly znamenaj\u237?:\par
\pard\fi-283\li360\sa60\ql {\f2\'95}\tab {\i w}{\sub i} \u8212? inzerovan\u225? ro\u269?n\u237? mzda v USD u {\i i}-t\u233?ho inzer\u225?tu (pro DE a IN p\u345?epo\u269?tena fixn\u237?mi kurzy, viz \u167?4.3);\par
\pard\fi-283\li360\sa60\ql {\f2\'95}\tab AI_Integration{\sub i} a Applied_Core_AI{\sub i} \u8212? bin\u225?rn\u237? indik\u225?tory \u250?rovn\u283? AI s referen\u269?n\u237? kategori\u237? None; koeficienty {\i \u947?}{\sub 1} a {\i \u947?}{\sub 2} zachycuj\u237? mzdovou pr\u233?mii za dan\u233? \u250?rovn\u283? oproti pozic\u237?m bez AI po\u382?adavku;\par
\pard\fi-283\li360\sa60\ql {\f2\'95}\tab {\i x}{\sub i} \u8212? vektor kontroln\u237?ch prom\u283?nn\u253?ch: vzd\u283?l\u225?n\u237? ({\f1 edu_ols}, 5 \u250?rovn\u237? s referen\u269?n\u237? kategori\u237? Bachelor+), zku\u353?enosti ({\f1 exp_category}, 4 \u250?rovn\u283? s referen\u269?n\u237? kategori\u237? Mid 3\u8211?5 let), 19 skill cluster\u367? (v\u353?ech 21 rodin technick\u253?ch dovednost\u237? krom\u283? Generative AI a Data Science\u8201?/\u8201?ML, viz od\u367?vodn\u283?n\u237? n\u237?\u382?e), typ a velikost firmy, NACE sektor a indik\u225?tor remote pr\u225?ce. Profesn\u237? skupina ({\f1 job_family}) nen\u237? v Tabulce 5 zahrnuta, proto\u382?e jej\u237? efekt je z velk\u233? \u269?\u225?sti zachycen 19 skill clustery a jednotn\u225? specifikace nap\u345?\u237?\u269? USA, N\u283?meckem a Indi\u237? zaji\u353?\u357?uje symetrickou interpretaci. Varianta pro USA dopln\u283?n\u225? o fixn\u237? efekty \u269?ty\u345? region\u367? US Census je uvedena v P\u345?\u237?loze D jako robustnostn\u237? kontrola region\u225?ln\u237? heterogenity;\par
\pard\fi-283\li360\sa60\ql {\f2\'95}\tab {\i \u949?}{\sub i} \u8212? n\u225?hodn\u225? chyba; standardn\u237? chyby odhad\u367? jsou klastrovan\u233? na \u250?rovni firmy ({\i vce}(cluster {\i firm})).\par
\pard\sa120\sl300\slmult1\ql Ekvivalentn\u283? lze (4.6) zapsat v explicitn\u283? vektorov\u233?m tvaru, ve kter\u233?m je kontroln\u237? vektor {\i x}{\sub i} rozlo\u382?en do tematick\u253?ch skupin \u8212? vektor \u250?rovn\u237? AI {\i AI}{\sub i} (indik\u225?tory {\f1 AI_Integration} a {\f1 Applied_Core_AI}), vektor lidsk\u233?ho kapit\u225?lu {\i HC}{\sub i} (vzd\u283?l\u225?n\u237? a zku\u353?enost), vektor 19 dovednostn\u237?ch klastr\u367? {\i SC}{\sub i}, vektor firemn\u237?ch charakteristik {\i FC}{\sub i} (typ a velikost firmy), sektorov\u253? vektor {\i SE}{\sub i} (NACE) a indik\u225?tor pracovn\u237?ho uspo\u345?\u225?d\u225?n\u237? {\i WA}{\sub i} (remote):\par
\pard\sb120\sa160\sl280\slmult1\qc ln\u8201?{\i w}{\sub i} = {\i \u945?} + {\i \u947?}\u183?{\i AI}{\sub i} + {\i \u946?}{\sub 1}\u183?{\i HC}{\sub i} + {\i \u946?}{\sub 2}\u183?{\i SC}{\sub i} + {\i \u946?}{\sub 3}\u183?{\i FC}{\sub i} + {\i \u946?}{\sub 4}\u183?{\i SE}{\sub i} + {\i \u946?}{\sub 5}\u183?{\i WA}{\sub i} + {\i \u949?}{\sub i}\par
\pard\sb0\sa160\qr\i (4.6\u8242?)\i0\par
\pard\sa120\sl300\slmult1\ql kde {\i \u947?} = ({\i \u947?}{\sub 1}, {\i \u947?}{\sub 2})\u8242? je vektor hlavn\u237?ch z\u225?jmov\u253?ch koeficient\u367? mzdov\u233? pr\u233?mie za AI \u250?rovn\u283? a {\i \u946?}{\sub 1} a\u382? {\i \u946?}{\sub 5} jsou vektory koeficient\u367? odpov\u237?daj\u237?c\u237? jednotliv\u253?m skupin\u225?m kontroln\u237?ch prom\u283?nn\u253?ch.\par
\pard\sa120\sl300\slmult1\ql Koeficienty {\i \u947?}{\sub 1} a {\i \u947?}{\sub 2} se p\u345?i z\u225?visl\u233? prom\u283?nn\u233? ln({\i w}{\sub i}) interpretuj\u237? jako semielasticita. Pro mal\u233? hodnoty lze aproximovat:\par
\pard\sb120\sa160\sl280\slmult1\qc mzdov\u225? pr\u233?mie \u8776? {\i \u947?}\u183?100\u8201?%,\u8195?p\u345?esn\u283?: 100\u183?(exp({\i \u947?}) \u8722? 1)\u8201?%\par
\pard\sb0\sa160\qr\i (4.7)\i0\par
\pard\sa120\sl300\slmult1\ql D\u367?le\u382?it\u253?m rozhodnut\u237?m bylo vy\u345?adit z hlavn\u237? OLS specifikace dovednostn\u237? klastry Generative AI a Data Science\u8201?/\u8201?ML, proto\u382?e jsou mechanicky propojeny s klasifikac\u237? {\f1 ai_level} (LLM je p\u345?i klasifikaci implicitn\u283? pou\u382?\u237?v\u225?) a jejich ponech\u225?n\u237? by vedlo k endogenit\u283? \u8212? koeficienty {\i \u947?}{\sub 1} a {\i \u947?}{\sub 2} by byly zkresleny sm\u283?rem k nule, proto\u382?e \u269?\u225?st AI pr\u233?mie by absorbovaly pr\u225?v\u283? tyto klastry. Robustnostn\u237? specifikace s plnou sadou 21 klastr\u367? je sou\u269?\u225?st\u237? p\u345?\u237?lohy.\par
\pard\sb280\sa140\keepn\f0\b\fs28 4.4.4 Standardn\u237? chyby a dopl\u328?kov\u233? testy\b0\fs22\par
\pard\sa120\sl300\slmult1\ql Ve v\u353?ech t\u345?ech regresn\u237?ch modelech jsou standardn\u237? chyby klastrovan\u233? na \u250?rovni firmy, proto\u382?e inzer\u225?ty t\u233?\u382?e firmy nejsou nez\u225?visl\u225? pozorov\u225?n\u237? (stejn\u233? HR odd\u283?len\u237?, stejn\u225? mzdov\u225? politika). Klastrovan\u253? odhadce kovarian\u269?n\u237? matice m\u225? tvar (Wooldridge, 2010):\par
\pard\sb120\sa160\sl280\slmult1\qc Var\u770?({\i \u946?\u770?}) = ({\i X}\u8242?{\i X}){\super \u8722?1}\u8201?[\u931?{\sub c=1}{\super C}\u8201?{\i X}{\sub c}\u8242? {\i u\u770?}{\sub c} {\i u\u770?}{\sub c}\u8242? {\i X}{\sub c}] ({\i X}\u8242?{\i X}){\super \u8722?1}\par
\pard\sb0\sa160\qr\i (4.8)\i0\par
\pard\sa120\sl300\slmult1\ql kde {\i c} = 1, \u8230?, {\i C} indexuje firmy, {\i X}{\sub c} je matice regresor\u367? odpov\u237?daj\u237?c\u237? firm\u283? {\i c} a {\i u\u770?}{\sub c} je vektor rezidu\u237? t\u233?to firmy. Stejn\u225? logika je uplatn\u283?na i u MLE model\u367? (bin\u225?rn\u237? a multinomick\u253? logit) prost\u345?ednictv\u237?m robustn\u237?ho klastrovan\u233?ho sandwich estim\u225?toru.\par
\pard\sa120\sl300\slmult1\ql V deskriptivn\u237? \u269?\u225?sti (kapitola 5.1) jsou pro testov\u225?n\u237? rozd\u237?l\u367? mezi skupinami pou\u382?ity \u967?\u178? testy nez\u225?vislosti (Pearson\u367?v ch\u237?-kvadr\u225?t) u kategori\u225?ln\u237?ch prom\u283?nn\u253?ch, dvouv\u253?b\u283?rov\u253? {\i t}-test a neparametrick\u253? Mann\u8211?Whitney U test pro spojit\u233? prom\u283?nn\u233? a ANOVA s Bonferroniho korekc\u237? pro v\u237?cen\u225?sobn\u225? srovn\u225?n\u237?.\par
