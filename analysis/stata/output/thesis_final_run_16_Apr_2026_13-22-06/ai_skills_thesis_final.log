. foreach c in US DE IN {
  2.     * Spocitat N v kazdem ai_level pro danou zemi a pripravit scaled kdensity
.     capture drop _kx_* _kf_*
  3.     local plot_cmd = ""
  4.     local plot_ok = 1
  5. 
.     foreach lv in 0 1 2 {
  6.         count if country == "`c'" & ai_level == `lv' & ln_salary != .
  7.         local n_`lv' = r(N)
  8.         if `n_`lv'' < 10 {
  9.             display as text "Skupina ai_level=`lv' v `c' ma jen `n_`lv'' obs — preskakujeme kdensity."
 10.             local plot_ok = 0
 11.             continue
 12.         }
 13.         capture noisily kdensity ln_salary if country == "`c'" & ai_level == `lv', ///
>             generate(_kx_`lv' _kf_`lv') nograph
 14.         if _rc != 0 {
 15.             display as error "kdensity selhal pro `c' ai_level=`lv' (rc=" _rc ")"
 16.             local plot_ok = 0
 17.             continue
 18.         }
 19.         * Preskalovat density -> frekvence
.         replace _kf_`lv' = _kf_`lv' * `n_`lv''
 20.     }
 21. 
.     if `plot_ok' == 1 {
 22.         capture noisily twoway ///
>             (line _kf_0 _kx_0, lcolor(gs10) lpattern(solid)) ///
>             (line _kf_1 _kx_1, lcolor(navy) lpattern(dash)) ///
>             (line _kf_2 _kx_2, lcolor(maroon) lpattern(shortdash)), ///
>             title("`c': Rozložení ln(plat) podle úrovně AI požadavku", size(medium)) ///
>             xtitle("ln(roční plat, USD)") ytitle("Frekvence") ///
>             legend(order(1 "None" 2 "AI Integration" 3 "Applied/Core AI") rows(1) size(small)) ///
>             graphregion(color(white)) bgcolor(white)
 23.         if _rc == 0 {
 24.             graph export "$outdir/Graf_Mzda_AI_`c'.png", replace width(1200)
 25.         }
 26.     }
 27.     capture drop _kx_* _kf_*
 28. }
