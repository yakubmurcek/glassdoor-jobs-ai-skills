>                             ib`nace_base'.sector_nace_num ///
>                             ib1.type_cat ///
>                             ib5.size_cat ///
>                             is_remote) ///
>         vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         estimates store heck_t4_`c'
  6.     }
  7.     else {
  8.         display as error "Heckman pro `c' selhal (rc=" _rc ")"
  9.     }
 10. }

