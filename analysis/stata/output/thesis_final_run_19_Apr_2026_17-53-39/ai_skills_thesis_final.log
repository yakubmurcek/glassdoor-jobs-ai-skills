==============================================================

. 
. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (Tabulka 4) ==========="
  3. 
.     * POZN: vzdelani (edu_logit) z mlogitu ZAMERNE vyrazeno — kategorie
.     * HS/Associate x Applied/Core AI ma v DE/IN < 25 pozorovani (quasi-
.     * complete separation risk). Stejny pristup pouzila verze 2024
.     * (ai_skills_analysis_comparative.do). Seniorita (exp_category) je
.     * zachovana, ma dostatecne buňky napric outcomy.
. 
.     * IIA Hausman test (vyzaduje model bez vce(cluster), otestujeme vynechani Core AI)
.     capture quietly mlogit ai_level cluster_* ib3.exp_category ib`nace_base'.sector_nace_num ib1.type_cat ib5.size_cat is_remote if country == "`c'", baseoutcome(0)
  4.     if _rc == 0 {
  5.         estimates store mfull_`c'
  6.         capture quietly mlogit ai_level cluster_* ib3.exp_category ib`nace_base'.sector_nace_num ib1.type_cat ib5.size_cat is_remote if country == "`c'" & ai_level != 2, baseoutcome(0)
  7.         if _rc == 0 {
  8.             estimates store msub_`c'
  9.             display _n ">> IIA Hausman Test pro `c' (Full vs subset bez Applied/Core AI)"
 10.             capture noisily hausman msub_`c' mfull_`c', alleqs constant
 11.         }
 12.     }
 13. 
.     * Tri beh modelu (pro kazdy outcome zvlast), protoze margins post prepisuje
.     * e(b). Pouzivame AME predict(outcome(k)) pro k=0,1,2.
.     foreach o in 0 1 2 {
 14.         capture noisily mlogit ai_level ///
>             cluster_* ///
>             ib3.exp_category ///
>             ib`nace_base'.sector_nace_num ///
>             ib1.type_cat ///
>             ib5.size_cat ///
>             is_remote ///
>             if country == "`c'", baseoutcome(0) vce(cluster firm_cluster)
 15.         if _rc == 0 {
 16.             quietly margins, dydx(*) predict(outcome(`o')) post
 17.             estadd local ctrl_nace   "Ano"
 18.             estadd local ctrl_type   "Ano"
 19.             estadd local ctrl_size   "Ano"
 20.             estadd local ctrl_remote "Ano"
 21.             estimates store ame_t3_`c'_`o'
 22.         }
 23.         else {
 24.             display as error "Mlogit Tabulka 4 pro `c' outcome `o' selhal (rc=" _rc ")"
 25.         }
 26.     }
 27. }

