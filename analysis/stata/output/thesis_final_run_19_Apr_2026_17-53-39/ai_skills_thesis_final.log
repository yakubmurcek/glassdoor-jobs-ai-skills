. 
. * --- 6b. Skill clustery panel ---
. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (T3 skill clustery) ==========="
  3.     capture noisily logit has_ai ///
>         cluster_* ///
>         ib2.edu_logit ///
>         ib3.exp_category ///
>         ib`nace_base'.sector_nace_num ///
>         ib1.type_cat ///
>         ib5.size_cat ///
>         is_remote ///
>         if country == "`c'", vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         quietly margins, dydx(*) post
  6.         estadd local ctrl_nace   "Ano"
  7.         estadd local ctrl_type   "Ano"
  8.         estadd local ctrl_size   "Ano"
  9.         estadd local ctrl_remote "Ano"
 10.         estimates store ame_t2sk_`c'
 11. 
.         * Hosmer-Lemeshow Goodness of Fit (vyzaduje model bez klastrovani)
.         capture quietly logit has_ai ///
>             cluster_* ///
>             ib2.edu_logit ///
>             ib3.exp_category ///
>             ib`nace_base'.sector_nace_num ///
>             ib1.type_cat ///
>             ib5.size_cat ///
>             is_remote ///
>             if country == "`c'"
 12.         if _rc == 0 {
 13.             display _n ">> Hosmer-Lemeshow GOF test pro `c' (bez klastrovani vzorku)"
 14.             capture noisily estat gof, group(10)
 15.         }
 16.     }
 17.     else {
 18.         display as error "Logit T3 (skill clustery) pro `c' selhal (rc=" _rc ")"
 19.     }
 20. }

