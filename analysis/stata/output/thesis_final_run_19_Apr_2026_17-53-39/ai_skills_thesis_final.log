. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (Heckman) ==========="
  3.     capture noisily heckman ln_salary ///
>         `ols_clusters' ///
>         i.ai_level ///
>         ib3.edu_ols ///
>         ib3.exp_category ///
>         ib`nace_base'.sector_nace_num ///
>         ib1.type_cat ///
>         ib5.size_cat ///
>         is_remote ///
>         if country == "`c'", ///
>         select(has_salary = `ols_clusters' ///
>                             i.ai_level ///
>                             ib3.edu_ols ///
>                             ib3.exp_category ///
>                             ib`nace_base'.sector_nace_num ///
>                             ib1.type_cat ///
>                             ib5.size_cat ///
>                             is_remote) ///
>         vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         estimates store heck_t4_`c'
  6.     }
  7.     else {
  8.         display as error "Heckman pro `c' selhal (rc=" _rc ")"
  9.     }
 10. }

