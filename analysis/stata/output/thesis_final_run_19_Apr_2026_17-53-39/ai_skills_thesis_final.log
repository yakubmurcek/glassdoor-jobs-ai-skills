. * ==============================================================================
. * 14. EXPORT PRO PYTHON GRAFY (CSV data pro analysis/charts/build_charts.py)
. * ==============================================================================
. * Tento blok NEMENI zadne odhady — pouze cte `e(b)`, `e(V)` z uz ulozenych
. * estimates a zapisuje hodnoty do CSV, ktere pak nacte Python skript.
. * Vystupy: 7 CSV souboru v $outdir/charts_data/
. display _n "=============================================================="

==============================================================

. display "14. EXPORT PRO PYTHON GRAFY"
14. EXPORT PRO PYTHON GRAFY

. display "=============================================================="
==============================================================

. 
. capture mkdir "$outdir/charts_data"

. 
. * --- Pomocny program: zapsat koeficienty + SE + p-value + 95% CI do CSV ---
. capture program drop _export_est

. program define _export_est
  1.     args ename outfile keeppat
  2.     capture estimates restore `ename'
  3.     if _rc != 0 {
  4.         display as error "Estimate `ename' nenalezen — preskakuji `outfile'."
  5.         exit 0
  6.     }
  7.     tempname b V
  8.     matrix `b' = e(b)
  9.     matrix `V' = e(V)
 10.     local names : colnames `b'
 11.     local K = colsof(`b')
 12.     tempname fh
 13.     file open `fh' using "`outfile'", write replace
 14.     file write `fh' "coef,b,se,z,p,ci_low,ci_high" _n
 15.     forvalues i = 1/`K' {
 16.         local nm : word `i' of `names'
 17.         if "`keeppat'" != "" {
 18.             if !strmatch("`nm'", "`keeppat'") continue
 19.         }
 20.         local bi = `b'[1, `i']
 21.         local vi = `V'[`i', `i']
 22.         if `vi' <= 0 | missing(`vi') continue
 23.         local sei = sqrt(`vi')
 24.         local zi  = `bi' / `sei'
 25.         local pi  = 2 * (1 - normal(abs(`zi')))
 26.         local lo  = `bi' - 1.96 * `sei'
 27.         local hi  = `bi' + 1.96 * `sei'
 28.         file write `fh' "`nm',`bi',`sei',`zi',`pi',`lo',`hi'" _n
 29.     }
 30.     file close `fh'
 31.     display "Exported: `outfile'"
 32. end

. 
. * ------------------------------------------------------------------
. * GRAF 1 — AI tier × country (crosstab pocty a %)
. * ------------------------------------------------------------------
. preserve

.     keep country ai_level

.     contract country ai_level

.     bysort country: egen _total = total(_freq)

