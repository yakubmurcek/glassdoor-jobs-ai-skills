. display _n "--- 6.0b Skill clustery vs ai_level (DE, IN) ---"

--- 6.0b Skill clustery vs ai_level (DE, IN) ---

. foreach c in DE IN {
  2.     display _n "=== Skill clustery x ai_level pro `c' ==="
  3.     foreach clvar of varlist cluster_* {
  4.         display "Crosstab `clvar' vs ai_level (`c')"
  5.         tab `clvar' ai_level if country == "`c'", row
  6.     }
  7. }

