. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (T2 job family) ==========="
  3.     capture noisily logit has_ai ///
>         ib`sw_base'.job_family_num ///
>         ib2.edu_logit ///
>         ib3.exp_category ///
>         ib`nace_base'.sector_nace_num ///
>         ib1.type_cat ///
>         ib5.size_cat ///
>         is_remote ///
>         if country == "`c'", vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         quietly margins, dydx(*) post
  6.         estadd local ctrl_nace   "Ano"
  7.         estadd local ctrl_type   "Ano"
  8.         estadd local ctrl_size   "Ano"
  9.         estadd local ctrl_remote "Ano"
 10.         estimates store ame_t2jf_`c'
 11.     }
 12.     else {
 13.         display as error "Logit T2 (job family) pro `c' selhal (rc=" _rc ")"
 14.     }
 15. }

