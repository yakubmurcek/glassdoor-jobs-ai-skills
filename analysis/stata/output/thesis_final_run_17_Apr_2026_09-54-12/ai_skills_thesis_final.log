. * --- Export Tabulky 1 do RTF pres matrix ---
. matrix T1 = J(3, 6, .)

. local row = 0

. foreach lv_num in 0 1 2 {
  2.     local ++row
  3.     local col = 0
  4.     foreach c in US DE IN {
  5.         count if country == "`c'"
  6.         local total = r(N)
  7.         count if country == "`c'" & ai_level == `lv_num'
  8.         local n = r(N)
  9.         local ++col
 10.         matrix T1[`row', `col'] = `n'
 11.         local ++col
 12.         matrix T1[`row', `col'] = 100 * `n' / `total'
 13.     }
 14. }
