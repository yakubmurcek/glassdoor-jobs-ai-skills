. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (Tabulka 4) ==========="
  3.     * Tri beh modelu (pro kazdy outcome zvlast), protoze margins post prepisuje
.     * e(b). Pouzivame AME predict(outcome(k)) pro k=0,1,2.
.     foreach o in 0 1 2 {
  4.         capture noisily mlogit ai_level ///
>             cluster_* ///
>             edu_bin edu_missing ///
>             exp_bin exp_missing ///
>             i.sector_nace_num ///
>             ib1.type_cat ///
>             ib5.size_cat ///
>             is_remote ///
>             if country == "`c'", baseoutcome(0) vce(cluster firm_cluster)
  5.         if _rc == 0 {
  6.             quietly margins, dydx(*) predict(outcome(`o')) post
  7.             estimates store ame_t4_`c'_`o'
  8.         }
  9.         else {
 10.             display as error "Mlogit Tabulka 4 pro `c' outcome `o' selhal (rc=" _rc ")"
 11.         }
 12.     }
 13. }

