  3.     capture noisily logit has_ai ///
>         ib`sw_base'.job_family_num ///
>         edu_bin edu_missing ///
>         exp_bin exp_missing ///
>         i.sector_nace_num ///
>         ib1.type_cat ///
>         ib5.size_cat ///
>         is_remote ///
>         if country == "`c'", vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         quietly margins, dydx(*) post
  6.         estimates store ame_t2_`c'
  7.     }
  8.     else {
  9.         display as error "Logit Tabulka 2 pro `c' selhal (rc=" _rc ")"
 10.     }
 11. }

