  3.     capture noisily heckman ln_salary ///
>         cluster_* ///
>         i.ai_level ///
>         edu_bin edu_missing ///
>         exp_bin exp_missing ///
>         i.sector_nace_num ///
>         ib1.type_cat ///
>         ib5.size_cat ///
>         is_remote ///
>         if country == "`c'", ///
>         select(has_salary = cluster_* ///
>                             i.ai_level ///
>                             edu_bin edu_missing ///
>                             exp_bin exp_missing ///
>                             i.sector_nace_num ///
>                             ib1.type_cat ///
>                             ib5.size_cat ///
>                             is_remote) ///
>         vce(cluster firm_cluster)
  4.     if _rc == 0 {
  5.         estimates store heck_t5_`c'
  6.     }
  7.     else {
  8.         display as error "Heckman pro `c' selhal (rc=" _rc ")"
  9.     }
 10. }

