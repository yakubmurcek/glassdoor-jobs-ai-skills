. * 7. TABULKA 3 — MLOGIT P(AI tier) ~ SKILL CLUSTERY (AME, 9 sloupcu)
. * ==============================================================================
. display _n "=============================================================="

==============================================================

. display "7. TABULKA 3 — MLOGIT, SKILL CLUSTERY"
7. TABULKA 3 — MLOGIT, SKILL CLUSTERY

. display "=============================================================="
==============================================================

. 
. foreach c in US DE IN {
  2.     display _n "=========== Zeme = `c' (Tabulka 3) ==========="
  3.     
.     * IIA Hausman test (vyzaduje model bez vce(cluster), otestujeme vynechani Core AI)
.     capture quietly mlogit ai_level cluster_* edu_bin edu_missing exp_bin exp_missing ib`nace_base'.sector_nace_num ib1.type_cat ib5.size_cat is_remote if country == "`c'", baseoutcome(0)
  4.     if _rc == 0 {
  5.         estimates store mfull_`c'
  6.         capture quietly mlogit ai_level cluster_* edu_bin edu_missing exp_bin exp_missing ib`nace_base'.sector_nace_num ib1.type_cat ib5.size_cat is_remote if country == "`c'" & ai_lev
> el != 2, baseoutcome(0)
  7.         if _rc == 0 {
  8.             estimates store msub_`c'
  9.             display _n ">> IIA Hausman Test pro `c' (Full vs subset bez Applied/Core AI)"
 10.             capture noisily hausman msub_`c' mfull_`c', alleqs constant
 11.         }
 12.     }
 13. 
.     * Tri beh modelu (pro kazdy outcome zvlast), protoze margins post prepisuje
.     * e(b). Pouzivame AME predict(outcome(k)) pro k=0,1,2.
.     foreach o in 0 1 2 {
 14.         capture noisily mlogit ai_level ///
>             cluster_* ///
>             edu_bin edu_missing ///
>             exp_bin exp_missing ///
>             ib`nace_base'.sector_nace_num ///
>             ib1.type_cat ///
>             ib5.size_cat ///
>             is_remote ///
>             if country == "`c'", baseoutcome(0) vce(cluster firm_cluster)
 15.         if _rc == 0 {
 16.             quietly margins, dydx(*) predict(outcome(`o')) post
 17.             estadd local ctrl_nace   "Ano"
 18.             estadd local ctrl_type   "Ano"
 19.             estadd local ctrl_size   "Ano"
 20.             estadd local ctrl_remote "Ano"
 21.             estimates store ame_t3_`c'_`o'
 22.         }
 23.         else {
 24.             display as error "Mlogit Tabulka 3 pro `c' outcome `o' selhal (rc=" _rc ")"
 25.         }
 26.     }
 27. }

